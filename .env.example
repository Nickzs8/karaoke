
# Diretório base de armazenamento de mídias (downloads, faixas separadas, gravações)
# Padrão: storage (dentro da raiz do projeto)
KARAOKE_STORAGE_DIR=storage

# Dispositivo para processamento de IA (Demucs)
# Opções: auto (detecta CUDA se disponível, senão CPU), cuda ou cpu
KARAOKE_DEVICE=auto

# Modelo neural Demucs para separação de faixas (voz / instrumental)
# Opções comuns: htdemucs (padrão, rápido e preciso), htdemucs_ft, mdx_extra
KARAOKE_DEMUCS_MODEL=htdemucs

# Prefixo de rota para streaming de arquivos estáticos de áudio na Web API
KARAOKE_BASE_AUDIO_URL=/static/audio

# URL base da API pública para busca de letras sincronizadas (.lrc)
KARAOKE_LRCLIB_URL=https://lrclib.net/api

# Peso da Afinação na nota final consolidada (0.0 a 1.0)
KARAOKE_PITCH_WEIGHT=0.7

# Peso do Ritmo na nota final consolidada (0.0 a 1.0)
KARAOKE_TIMING_WEIGHT=0.3

# Tolerância em cents para nota máxima de afinação (1 semitom = 100 cents)
# Até 50 cents de desvio (1/4 de tom), a nota de afinação é 100.0
KARAOKE_CENTS_TOLERANCE=50.0
